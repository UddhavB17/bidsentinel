{
  "name": "bidsentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first tender change monitoring MVP",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm demo:collector",
    "collect": "pnpm --filter @bidsentinel/collector-worker collect",
    "start:api": "pnpm --filter @bidsentinel/collector-worker start",
    "dev:web": "pnpm --filter @bidsentinel/web dev",
    "dev:chaos-source": "pnpm --filter @bidsentinel/chaos-source dev",
    "demo:collector": "pnpm --filter @bidsentinel/collector-worker demo",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
}
