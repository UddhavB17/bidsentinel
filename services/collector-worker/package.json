{
  "name": "@bidsentinel/collector-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/server.ts --format esm --dts --clean",
    "demo": "node --env-file-if-exists=../../.env --import tsx src/cli.ts",
    "collect": "node --env-file-if-exists=../../.env --import tsx src/collect-cycle.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bidsentinel/brightdata": "workspace:*",
    "@bidsentinel/contracts": "workspace:*",
    "@bidsentinel/validation": "workspace:*",
    "zod": "catalog:"
  }
}
